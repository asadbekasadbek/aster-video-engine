# Copy to .env in the directory from which you launch Aster (stream mode).
# 1 = read upcoming DiT blocks while the GPU computes; 0 = original stream.
ASTER_PREFETCH=1
# Percent of currently available physical RAM for extra read-ahead buffers.
ASTER_PREFETCH_RAM_PERCENT=10
# Percent of currently free GPU memory for blocks reused across denoising steps.
ASTER_PREFETCH_VRAM_PERCENT=25
