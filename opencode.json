{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/aster-coder",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "aster-coder": {
          "name": "Aster Coder 30B",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "allow",
      "git push *": "ask",
      "git reset --hard *": "ask",
      "git clean *": "ask",
      "git checkout -- *": "ask",
      "Remove-Item *": "ask",
      "del *": "ask",
      "rmdir *": "ask",
      "rd *": "ask",
      "winget install *": "ask",
      "choco install *": "ask",
      "ollama pull *": "ask"
    },
    "external_directory": "ask"
  }
}